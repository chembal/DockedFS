# Copy to .env and fill in. Never commit .env.

# --- From your friend (the client) -----------------------------------------
# A tagged, pre-approved auth key from YOUR FRIEND'S tailnet, so this host joins
# their network as a single locked-down device.
TS_AUTHKEY=tskey-auth-REPLACE_ME
# CHAP login your friend will use. Password must be 12-16 characters.
CHAP_USER=friend
CHAP_PASSWORD=change-me-1234

# --- Your limits (the host) -------------------------------------------------
# Folder on this machine that holds the encrypted disk image.
DATA_DIR=./data
# Maximum size offered. Can be raised later, never lowered.
STORAGE_SIZE=500G
# false = grow on demand (sparse file), true = reserve all space up front.
PREALLOCATE=false
# Cap in Mbit/s, applied to upload and download separately. Empty = unlimited.
MAX_BANDWIDTH_MBIT=

# Name this host shows up as on your friend's tailnet.
TS_HOSTNAME=dockedfs
