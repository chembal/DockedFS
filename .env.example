# Copy to .env and fill in. Never commit .env.

# --- From your friend (the client) -----------------------------------------
# A tagged, single-use auth key from YOUR FRIEND'S tailnet, so this host joins
# their network as a single locked-down device. Keep it here after the first
# start: the iSCSI (CHAP) login is derived from it, so only your friend, who
# made the key, can attach the disk. Nothing else needs to be exchanged.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Advanced. Leave empty to use the login derived from TS_AUTHKEY.
CHAP_USER=
CHAP_PASSWORD=
# true = no iSCSI login at all; only the tailnet ACL controls access.
CHAP_DISABLE=false

# Keep true. The firewall stops these containers from reaching your LAN and lets
# out only Tailscale's own traffic. false is for debugging only.
FIREWALL=true

# --- Your limits (the host) -------------------------------------------------
# Folder on this machine that holds the encrypted disk image.
DATA_DIR=./data
# Maximum size offered. Can be raised later, never lowered.
STORAGE_SIZE=500G
# false = grow on demand (sparse file), true = reserve all space up front.
PREALLOCATE=false
# Cap in Mbit/s, applied to upload and download separately. Empty = unlimited.
MAX_BANDWIDTH_MBIT=

# Name this host shows up as on your friend's tailnet.
TS_HOSTNAME=dockedfs
